{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-skills/eval.schema.json",
  "title": "Agent Skill Evaluation Contract",
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixture": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "real",
            "virtual",
            "isolated_repo"
          ]
        },
        "contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "behaviorCase": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "expected_output",
        "files",
        "expectations"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expected_output": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        },
        "expectations": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "required_information": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "forbidden_behaviors": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "expected_side_effects": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "verification": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "platform_requirements": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": true
    },
    "triggerCase": {
      "type": "object",
      "required": [
        "id",
        "query",
        "should_trigger",
        "expectations"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "should_trigger": {
          "type": "boolean"
        },
        "expectations": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": true
    },
    "routingCase": {
      "type": "object",
      "required": [
        "id",
        "query",
        "expected_primary_skill",
        "allowed_companions",
        "forbidden_skills",
        "expected_no_skill",
        "expected_sequence",
        "runs",
        "minimum_primary_trigger_rate",
        "maximum_forbidden_trigger_rate",
        "expectations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "expected_primary_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_companions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_no_skill": {
          "type": "boolean"
        },
        "expected_sequence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_primary_trigger_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_forbidden_trigger_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expectations": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "skill_name",
        "evals"
      ],
      "properties": {
        "skill_name": {
          "type": "string",
          "minLength": 1
        },
        "evals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/behaviorCase"
          }
        }
      }
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/triggerCase"
      }
    },
    {
      "type": "object",
      "required": [
        "routing_cases"
      ],
      "properties": {
        "routing_cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routingCase"
          }
        }
      }
    }
  ]
}
